{%- liquid
  assign social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign social_icons = false
  endif
  if section.settings.enable_country_selector or section.settings.enable_language_selector
    assign language_country_selector = true
  endif
  if section.blocks.size > 0
    assign announcement_bar = true
  endif
  assign show_utilities = false
  if language_country_selector or section.settings.show_social and social_icons
    assign show_utilities = true
  endif
  assign ticker_repeat = 4
-%}

{% if social_icons %}
  {{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- style -%}
  #shopify-section-{{ section.id }} .announcement-ticker {
    --ticker-bg: {{ section.settings.color_background }};
    --ticker-text: {{ section.settings.color_text }};
    --ticker-duration: {{ section.settings.ticker_duration }}s;
  }
{%- endstyle -%}

<div
  class="utility-bar announcement-ticker{% if section.settings.show_line_separator %} announcement-ticker--border{% endif %}"
>
  {%- if announcement_bar -%}
    <div
      class="announcement-ticker__viewport"
      role="region"
      aria-label="{{ 'sections.header.announcement' | t }}"
    >
      <div class="announcement-ticker__track">
        {%- for half in (1..2) -%}
          <div class="announcement-ticker__half"{% unless forloop.first %} aria-hidden="true"{% endunless %}>
            {%- for copy in (1..ticker_repeat) -%}
              {%- for block in section.blocks -%}
                {%- if block.settings.text != blank -%}
                  {%- assign is_original = false -%}
                  {%- if forloop.parentloop.first and forloop.parentloop.parentloop.first -%}
                    {%- assign is_original = true -%}
                  {%- endif -%}
                  <span
                    class="announcement-ticker__item"
                    {% if is_original %}{{ block.shopify_attributes }}{% endif %}
                    {% unless is_original %}aria-hidden="true"{% endunless %}
                  >
                    {%- if block.settings.link != blank -%}
                      <a
                        href="{{ block.settings.link }}"
                        class="announcement-ticker__link"
                        {% unless is_original %}tabindex="-1"{% endunless %}
                      >
                        {{- block.settings.text | escape -}}
                      </a>
                    {%- else -%}
                      {{- block.settings.text | escape -}}
                    {%- endif -%}
                  </span>
                  <span class="announcement-ticker__separator" aria-hidden="true">{{ section.settings.separator | escape }}</span>
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if show_utilities -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width utility-bar__grid{% if language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--2-col{% endif %}">
    {%- if section.settings.show_social and social_icons -%}
      {%- render 'social-icons' -%}
    {%- endif -%}
    <div class="localization-wrapper">
      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementCountryForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementCountryLabel">{{ 'localization.country_label' | t }}</h2>
              {%- render 'country-localization', localPosition: 'AnnouncementCountry' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {% endif %}

      {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementLanguageForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementLanguageLabel">{{ 'localization.language_label' | t }}</h2>
              {%- render 'language-localization', localPosition: 'AnnouncementLanguage' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {%- endif -%}
    </div>
  </div>
  </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .announcement-ticker {
    padding: 0;
  }

  .announcement-ticker--border {
    border-bottom: 0;
  }

  .announcement-ticker__viewport {
    overflow: hidden;
    background: var(--ticker-bg);
    color: var(--ticker-text);
  }

  .announcement-ticker__track {
    display: flex;
    width: max-content;
    animation: announcement-ticker-scroll var(--ticker-duration) linear infinite;
  }

  .announcement-ticker__half {
    display: flex;
    flex-shrink: 0;
    align-items: center;
  }

  .announcement-ticker__item,
  .announcement-ticker__separator {
    padding: 1rem 1.6rem;
    font-size: 1.5rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ticker-text);
  }

  .announcement-ticker__separator {
    padding-inline: 0;
  }

  .announcement-ticker__link {
    color: inherit;
    text-decoration: none;
  }

  .announcement-ticker__link:hover,
  .announcement-ticker__link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.4rem;
  }

  /* Pausa al pasar el ratón o al navegar con teclado dentro de la barra */
  .announcement-ticker__viewport:hover .announcement-ticker__track,
  .announcement-ticker__viewport:focus-within .announcement-ticker__track {
    animation-play-state: paused;
  }

  @keyframes announcement-ticker-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Marquesina"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Color de fondo",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Color del texto",
      "default": "#39FF14"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Símbolo separador",
      "info": "Se coloca entre mensajes. Por ejemplo: ★ o •",
      "default": "★"
    },
    {
      "type": "range",
      "id": "ticker_duration",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "s",
      "label": "Duración de un ciclo completo",
      "info": "Más segundos = desplazamiento más lento.",
      "default": 40
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4",
      "info": "Solo afecta a la fila de redes sociales e idioma/país."
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.heading_utilities.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.announcement-bar.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": false,
      "label": "t:sections.announcement-bar.settings.show_social.label",
      "info": "t:sections.announcement-bar.settings.show_social.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_country_selector.label",
      "info": "t:sections.announcement-bar.settings.enable_country_selector.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_language_selector.label",
      "info": "t:sections.announcement-bar.settings.enable_language_selector.info"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "🔥 10% DTO CON EL CÓDIGO BIENVENIDO10",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
