{%- comment -%}
  Compra por modalidad: tarjetas con imagen para los modelos de venta
  (lotes por kilo, lotes por prendas y mayorista). Máximo 4 bloques.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign block_count = section.blocks.size -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="shop-by-model__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="caption-with-letter-spacing">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="title h1">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="shop-by-model__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if block_count > 0 -%}
      <ul
        class="shop-by-model__list grid grid--1-col{% if block_count == 4 %} grid--2-col-tablet grid--4-col-desktop{% else %} grid--3-col-tablet{% endif %}"
        role="list"
      >
        {%- for block in section.blocks -%}
          <li class="grid__item" {{ block.shopify_attributes }}>
            <{% if block.settings.link != blank %}a href="{{ block.settings.link }}"{% else %}div{% endif %} class="shop-by-model__card">
              <div class="shop-by-model__media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '450, 700, 900',
                      sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw'
                  }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <div class="shop-by-model__content">
                {%- if block.settings.title != blank -%}
                  <h3 class="shop-by-model__title h3">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="shop-by-model__desc">{{ block.settings.text | escape }}</p>
                {%- endif -%}
                {%- if block.settings.link != blank and block.settings.link_label != blank -%}
                  <span class="shop-by-model__cta">{{ block.settings.link_label | escape }} &rarr;</span>
                {%- endif -%}
              </div>
            </{% if block.settings.link != blank %}a{% else %}div{% endif %}>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .shop-by-model__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 3.2rem;
    text-align: center;
  }

  .shop-by-model__header > * {
    margin: 0;
  }

  .shop-by-model__text {
    max-width: 56rem;
    color: rgba(var(--color-foreground), 0.75);
  }

  .shop-by-model__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .shop-by-model__card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 16px;
    color: #fff;
    text-decoration: none;
    aspect-ratio: 4 / 5;
    background: rgb(var(--color-foreground));
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }

  a.shop-by-model__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 34px rgba(31, 27, 24, 0.18);
  }

  .shop-by-model__media,
  .shop-by-model__media img,
  .shop-by-model__media svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .shop-by-model__media img,
  .shop-by-model__media svg {
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  a.shop-by-model__card:hover .shop-by-model__media img {
    transform: scale(1.05);
  }

  .shop-by-model__content {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 6rem 2.4rem 2.4rem;
    background: linear-gradient(to top, rgba(31, 27, 24, 0.78), rgba(31, 27, 24, 0));
  }

  .shop-by-model__content > * {
    margin: 0;
    color: #fff;
  }

  .shop-by-model__desc {
    font-size: 1.4rem;
    opacity: 0.9;
  }

  .shop-by-model__cta {
    margin-top: 0.6rem;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Compra por modalidad",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta superior", "default": "Nuestros lotes" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Elige cómo quieres comprar" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Ropa vintage y de segunda mano de marcas de calidad, en el formato que mejor encaje con tu negocio." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Margen superior", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Margen inferior", "default": 56 }
  ],
  "blocks": [
    {
      "type": "model",
      "name": "Modalidad",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "title", "label": "Título", "default": "Lotes por kilos" },
        { "type": "text", "id": "text", "label": "Descripción" },
        { "type": "url", "id": "link", "label": "Enlace" },
        { "type": "text", "id": "link_label", "label": "Texto del enlace", "default": "Ver lotes" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Compra por modalidad",
      "blocks": [
        { "type": "model", "settings": { "title": "Lotes por kilos", "text": "Compra por peso y ajusta el volumen a tu tienda.", "link_label": "Ver lotes" } },
        { "type": "model", "settings": { "title": "Lotes por prendas", "text": "Cantidades cerradas de prendas seleccionadas.", "link_label": "Ver lotes" } },
        { "type": "model", "settings": { "title": "Al por mayor", "text": "Grandes volúmenes con condiciones a medida.", "link_label": "Pedir presupuesto" } }
      ]
    }
  ]
}
{% endschema %}
