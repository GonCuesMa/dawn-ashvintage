{%- comment -%}
  Packs por kilos: tarjetas con foto, etiqueta, título, kilos y precio por kilo.
  Cada bloque puede enlazar a un producto y sacar de él título, foto, kilos y precio por kilo
  (se calculan con el peso y el precio de sus variantes), o rellenarse a mano. Máximo 4 bloques.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign block_count = section.blocks.size -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="kilo-packs__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="title h1">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="kilo-packs__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if block_count > 0 -%}
      <ul
        class="kilo-packs__list grid grid--1-col grid--2-col-tablet{% if block_count > 2 %} grid--4-col-desktop{% endif %}"
        role="list"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign pack_product = block.settings.product
            assign pack_title = block.settings.title | default: pack_product.title
            assign pack_link = block.settings.link | default: pack_product.url
            assign pack_image = block.settings.image | default: pack_product.featured_media.preview_image
            assign kilos_text = block.settings.kilos
            assign price_text = block.settings.price_text

            if pack_product != blank and kilos_text == blank or pack_product != blank and price_text == blank
              assign min_ppk = 0
              assign min_kg = 0
              assign max_kg = 0
              for variant in pack_product.variants
                assign kg = variant.weight | times: 1.0 | divided_by: 1000
                if kg > 0
                  assign ppk = variant.price | times: 1.0 | divided_by: kg
                  if min_ppk == 0 or ppk < min_ppk
                    assign min_ppk = ppk
                  endif
                  if min_kg == 0 or kg < min_kg
                    assign min_kg = kg
                  endif
                  if kg > max_kg
                    assign max_kg = kg
                  endif
                endif
              endfor
              if min_kg > 0
                if kilos_text == blank
                  assign min_label = min_kg | round: 1 | remove: '.0'
                  assign max_label = max_kg | round: 1 | remove: '.0'
                  if min_label == max_label
                    assign kilos_text = min_label | append: ' kg'
                  else
                    assign kilos_text = min_label | append: '–' | append: max_label | append: ' kg'
                  endif
                endif
                if price_text == blank
                  assign ppk_money = min_ppk | round | money
                  assign price_text = section.settings.price_prefix | append: ' ' | append: ppk_money | append: '/kg'
                endif
              endif
            endif
          -%}
          <li class="grid__item" {{ block.shopify_attributes }}>
            {%- if pack_link != blank -%}
              <a href="{{ pack_link }}" class="kilo-packs__card">
            {%- else -%}
              <div class="kilo-packs__card">
            {%- endif -%}
              <div class="kilo-packs__media">
                {%- if pack_image != blank -%}
                  {{
                    pack_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 800',
                      sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw',
                      alt: pack_title
                  }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
                {%- if block.settings.badge != blank -%}
                  <span class="kilo-packs__badge">{{ block.settings.badge | escape }}</span>
                {%- endif -%}
              </div>
              <div class="kilo-packs__body">
                {%- if pack_title != blank -%}
                  <h3 class="kilo-packs__title h3">{{ pack_title | escape }}</h3>
                {%- endif -%}
                {%- if kilos_text != blank or price_text != blank -%}
                  <p class="kilo-packs__meta">
                    {%- if kilos_text != blank -%}
                      <span class="kilo-packs__kg">{{ kilos_text | escape }}</span>
                    {%- endif -%}
                    {%- if price_text != blank -%}
                      <span class="kilo-packs__price">{{ price_text | escape }}</span>
                    {%- endif -%}
                  </p>
                {%- endif -%}
                {%- if block.settings.highlight != blank -%}
                  <span class="kilo-packs__chip">{{ block.settings.highlight | escape }}</span>
                {%- endif -%}
              </div>
            {%- if pack_link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .kilo-packs__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 3.2rem;
    text-align: center;
  }

  .kilo-packs__header > * {
    margin: 0;
  }

  .kilo-packs__text {
    max-width: 56rem;
    color: rgba(var(--color-foreground), 0.75);
  }

  .kilo-packs__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .kilo-packs__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgba(var(--color-foreground), 0.12);
    border-radius: 16px;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  a.kilo-packs__card:hover {
    transform: translateY(-4px);
    border-color: transparent;
    box-shadow: 0 14px 34px rgba(31, 27, 24, 0.14);
  }

  .kilo-packs__media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f1ebe1;
  }

  .kilo-packs__media img,
  .kilo-packs__media svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .kilo-packs__media svg {
    opacity: 0.25;
  }

  a.kilo-packs__card:hover .kilo-packs__media img {
    transform: scale(1.05);
  }

  .kilo-packs__badge {
    position: absolute;
    top: 1.2rem;
    left: 1.2rem;
    padding: 0.5rem 1.2rem;
    border-radius: 40px;
    background: rgba(250, 249, 246, 0.94);
    color: #1f1b18;
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .kilo-packs__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.8rem;
    padding: 2rem 2rem 2.2rem;
  }

  .kilo-packs__title {
    margin: 0;
    font-size: 2rem;
  }

  .kilo-packs__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1.2rem;
    margin: 0;
  }

  .kilo-packs__kg {
    font-family: var(--font-heading-family);
    font-size: 2.8rem;
    line-height: 1;
  }

  .kilo-packs__price {
    color: var(--ash-accent, #a8553a);
    font-size: 1.5rem;
    font-weight: 600;
  }

  .kilo-packs__chip {
    margin-top: auto;
    padding: 0.5rem 1.2rem;
    border-radius: 40px;
    background: #f1ebe1;
    color: var(--ash-accent, #a8553a);
    font-size: 1.2rem;
    font-weight: 600;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Packs por kilos",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Elige tu pack por kilos" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Cuantos más kilos llevas, más baja el precio por kilo y más crece tu margen de venta." },
    { "type": "text", "id": "price_prefix", "label": "Prefijo del precio por kilo", "info": "Se usa cuando el precio se calcula automáticamente desde el producto.", "default": "Desde" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Margen superior", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Margen inferior", "default": 56 }
  ],
  "blocks": [
    {
      "type": "pack",
      "name": "Pack",
      "settings": [
        { "type": "product", "id": "product", "label": "Producto", "info": "Si lo eliges, se rellenan solos el título, la foto, los kilos y el precio por kilo (usa el peso de las variantes)." },
        { "type": "image_picker", "id": "image", "label": "Imagen", "info": "Sustituye a la imagen del producto." },
        { "type": "text", "id": "badge", "label": "Etiqueta sobre la imagen", "default": "Para empezar" },
        { "type": "text", "id": "title", "label": "Título", "info": "Sustituye al nombre del producto." },
        { "type": "text", "id": "kilos", "label": "Kilos", "info": "Sustituye al valor calculado. Ejemplo: 7 kg" },
        { "type": "text", "id": "price_text", "label": "Precio por kilo", "info": "Sustituye al valor calculado. Ejemplo: Desde 16 €/kg" },
        { "type": "text", "id": "highlight", "label": "Destacado", "default": "+5 prendas gratis" },
        { "type": "url", "id": "link", "label": "Enlace", "info": "Sustituye al enlace del producto." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Packs por kilos",
      "blocks": [
        { "type": "pack", "settings": { "badge": "Para empezar", "title": "Lote Inicial", "kilos": "7 kg", "price_text": "Desde 16 €/kg", "highlight": "+5 prendas gratis" } },
        { "type": "pack", "settings": { "badge": "Para crecer", "title": "Lote Selección", "kilos": "15 kg", "price_text": "Desde 14 €/kg", "highlight": "+10 prendas gratis" } },
        { "type": "pack", "settings": { "badge": "Más pedido", "title": "Lote Premium", "kilos": "25 kg", "price_text": "Desde 10 €/kg", "highlight": "El más vendido" } },
        { "type": "pack", "settings": { "badge": "Para negocios", "title": "Lote Profesional", "kilos": "100 kg", "price_text": "Desde 8 €/kg", "highlight": "Mejor precio por kilo" } }
      ]
    }
  ]
}
{% endschema %}
