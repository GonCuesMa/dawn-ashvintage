{%- comment -%}
  Página de categoría padre: muestra como tarjetas los hijos de la entrada del menú
  cuyo enlace apunta a esta misma página (p. ej. "Tipo de venta" -> /pages/tipo-de-venta).
  No hay que configurar nada más que el menú en Shopify.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign parent = null
  for entry in section.settings.menu.links
    if entry.url == page.url or entry.url == request.path
      assign parent = entry
      break
    endif
  endfor
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding menu-children">
    <header class="menu-children__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="subtitle menu-children__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="title h0 menu-children__title">{{ page.title | escape }}</h1>
      {%- if page.content != blank -%}
        <div class="rte menu-children__text">{{ page.content }}</div>
      {%- endif -%}
    </header>

    {%- if parent != blank and parent.links.size > 0 -%}
      <ul class="menu-children__grid list-unstyled" role="list">
        {%- for child in parent.links -%}
          {%- assign image = child.object.featured_image -%}
          <li>
            <a href="{{ child.url }}" class="menu-children__card">
              <span class="menu-children__media">
                {%- if image != blank -%}
                  {{
                    image
                    | image_url: width: 600
                    | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw', alt: ''
                  }}
                {%- endif -%}
              </span>
              <span class="menu-children__name">
                {{- child.title | escape -}}
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p class="menu-children__empty">
        No se encontraron subcategorías: en Navegación, la entrada padre del menú debe enlazar a esta página y tener elementos anidados debajo.
      </p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .menu-children__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-bottom: 3.2rem;
    text-align: center;
  }

  .menu-children__eyebrow,
  .menu-children__title {
    margin: 0;
  }

  .menu-children__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.6rem;
    margin: 0;
    padding: 0;
  }

  @media screen and (min-width: 750px) {
    .menu-children__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.4rem;
    }
  }

  @media screen and (min-width: 990px) {
    .menu-children__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .menu-children__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgba(var(--color-foreground), 0.1);
    border-radius: 16px;
    color: rgb(var(--color-foreground));
    text-decoration: none;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .menu-children__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 34px rgba(31, 27, 24, 0.14);
  }

  .menu-children__media {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f1ebe1;
  }

  .menu-children__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .menu-children__card:hover .menu-children__media img {
    transform: scale(1.06);
  }

  .menu-children__name {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 1.4rem 1.6rem;
    font-size: 1.5rem;
    font-weight: 600;
  }

  .menu-children__name svg {
    flex: none;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .menu-children__card:hover .menu-children__name svg {
    transform: translateX(4px);
  }

  .menu-children__empty {
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-children__card,
    .menu-children__media img,
    .menu-children__name svg {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Subcategorías del menú",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú",
      "default": "main-menu",
      "info": "Se muestran los hijos de la entrada de este menú que enlace a esta página."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta superior",
      "default": "Elige una categoría"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen superior",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen inferior",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Subcategorías del menú"
    }
  ]
}
{% endschema %}
