{%- comment -%}
  Banda para negocios: invita a profesionales a pedir presupuesto de lotes al por mayor.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="page-width section-{{ section.id }}-padding">
  <div class="wholesale-cta color-{{ section.settings.color_scheme }} gradient">
    {%- if section.settings.image != blank -%}
      <div class="wholesale-cta__media">
        {{
          section.settings.image
          | image_url: width: 900
          | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(min-width: 750px) 40vw, 100vw', alt: section.settings.image.alt
        }}
      </div>
    {%- endif -%}
    <div class="wholesale-cta__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="subtitle wholesale-cta__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="title h1 wholesale-cta__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="wholesale-cta__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="button button--primary wholesale-cta__button">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .wholesale-cta {
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
    border-radius: 2rem;
  }

  @media screen and (min-width: 750px) {
    .wholesale-cta:has(.wholesale-cta__media) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .wholesale-cta__media img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 36rem;
    object-fit: cover;
  }

  @media screen and (min-width: 750px) {
    .wholesale-cta__media img {
      max-height: none;
    }
  }

  .wholesale-cta__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1.2rem;
    padding: 3.2rem 2.4rem;
  }

  @media screen and (min-width: 750px) {
    .wholesale-cta__content {
      padding: 5.6rem 5rem;
    }
  }

  .wholesale-cta__eyebrow,
  .wholesale-cta__heading,
  .wholesale-cta__text {
    margin: 0;
  }

  .wholesale-cta__text {
    max-width: 46rem;
    font-size: 1.6rem;
    line-height: 1.65;
  }

  .wholesale-cta__button {
    margin-top: 1rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Banda para negocios",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta superior",
      "default": "Para negocios"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "¿Tienes una tienda? Hablemos de volumen"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Lotes al por mayor con la misma garantía de Clase A. Cuéntanos qué necesitas y te preparamos una propuesta."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Ver lotes al por mayor"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen superior",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen inferior",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Banda para negocios"
    }
  ]
}
{% endschema %}
