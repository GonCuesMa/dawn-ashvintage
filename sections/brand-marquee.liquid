{%- comment -%}
  Barra de marcas: cinta en movimiento con nombres (o logos subidos) de las marcas del catálogo.
  Por defecto cada marca se muestra como texto tipográfico. Se detiene al pasar el cursor
  y no se anima si el usuario prefiere reducir movimiento.
  La velocidad se expresa en píxeles por segundo (unidad del ajuste: 'px', máx. 3 caracteres en Shopify).
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="section-{{ section.id }}-padding brand-marquee">
      {%- if section.settings.heading != blank -%}
        <p class="brand-marquee__heading subtitle">{{ section.settings.heading | escape }}</p>
      {%- endif -%}

      <brand-marquee class="brand-marquee__viewport" data-speed="{{ section.settings.speed }}">
        <div class="brand-marquee__track">
          {%- for copy in (1..2) -%}
            <ul
              class="brand-marquee__list list-unstyled"
              role="list"
              {% if copy == 2 %}
                aria-hidden="true"
              {% endif %}
            >
              {%- for block in section.blocks -%}
                <li class="brand-marquee__item" {% if copy == 1 %}{{ block.shopify_attributes }}{% endif %}>
                  {%- if block.settings.logo != blank -%}
                    {{
                      block.settings.logo
                      | image_url: height: 120
                      | image_tag: loading: 'lazy', height: 48, class: 'brand-marquee__logo', alt: block.settings.name
                    }}
                  {%- else -%}
                    <span class="brand-marquee__name">{{ block.settings.name | escape }}</span>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- endfor -%}
        </div>
      </brand-marquee>

      {%- if section.settings.disclaimer != blank -%}
        <p class="brand-marquee__disclaimer page-width">{{ section.settings.disclaimer | escape }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .brand-marquee__heading {
    margin: 0 0 2rem;
    text-align: center;
  }

  .brand-marquee__viewport {
    display: block;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .brand-marquee__track {
    display: flex;
    width: max-content;
    will-change: transform;
    /* Sin JS: desplazamiento CSS simple. Con JS (data-js) lo mueve el script con frenado suave */
    animation: brand-marquee-scroll 60s linear infinite;
  }

  .brand-marquee__viewport[data-js] .brand-marquee__track {
    animation: none;
  }

  .brand-marquee__viewport:not([data-js]):hover .brand-marquee__track {
    animation-play-state: paused;
  }

  .brand-marquee__list {
    display: flex;
    flex: none;
    align-items: center;
    margin: 0;
    padding: 0;
  }

  .brand-marquee__item {
    display: flex;
    align-items: center;
    padding: 0 3.2rem;
    white-space: nowrap;
  }

  .brand-marquee__name {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 2.4rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground));
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .brand-marquee__logo {
    width: auto;
    height: 4rem;
    opacity: 0.7;
    filter: grayscale(1);
    transition: opacity 0.3s ease, filter 0.3s ease;
  }

  .brand-marquee__item:hover .brand-marquee__name,
  .brand-marquee__item:hover .brand-marquee__logo {
    opacity: 1;
    filter: none;
  }

  .brand-marquee__disclaimer {
    margin-top: 1.6rem;
    font-size: 1.1rem;
    text-align: center;
    opacity: 0.55;
  }

  @keyframes brand-marquee-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-marquee__viewport {
      -webkit-mask-image: none;
      mask-image: none;
    }

    .brand-marquee__track {
      width: auto;
      animation: none;
    }

    .brand-marquee__list {
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 1.2rem;
    }

    .brand-marquee__list[aria-hidden='true'] {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('brand-marquee')) {
    customElements.define(
      'brand-marquee',
      class BrandMarquee extends HTMLElement {
        connectedCallback() {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

          this.track = this.querySelector('.brand-marquee__track');
          this.original = this.querySelector('.brand-marquee__list');
          if (!this.track || !this.original) return;

          this.speed = parseFloat(this.dataset.speed) || 30; // px/s
          this.offset = 0;
          this.velocity = this.speed;
          this.accel = 0;
          this.target = this.speed;
          this.visible = true;
          this.running = false;

          this.setAttribute('data-js', '');
          this.measure();

          this.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && this.setPaused(true));
          this.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && this.setPaused(false));
          this.addEventListener('focusin', () => this.setPaused(true));
          this.addEventListener('focusout', () => this.setPaused(false));

          this.resizeObserver = new ResizeObserver(() => this.measure());
          this.resizeObserver.observe(this);
          this.intersectionObserver = new IntersectionObserver(([entry]) => {
            this.visible = entry.isIntersecting;
            if (this.visible) this.start();
          });
          this.intersectionObserver.observe(this);

          this.start();
        }

        disconnectedCallback() {
          if (this.resizeObserver) this.resizeObserver.disconnect();
          if (this.intersectionObserver) this.intersectionObserver.disconnect();
          this.running = false;
        }

        // Asegura copias suficientes para cubrir el ancho aunque haya pocos logos
        measure() {
          this.loop = this.original.getBoundingClientRect().width;
          if (!this.loop) return;
          const needed = Math.ceil((this.clientWidth * 2) / this.loop) + 1;
          const lists = this.track.querySelectorAll('.brand-marquee__list');
          for (let i = lists.length; i < needed; i++) {
            const clone = this.original.cloneNode(true);
            clone.setAttribute('aria-hidden', 'true');
            clone.querySelectorAll('[data-shopify-editor-block]').forEach((el) => el.removeAttribute('data-shopify-editor-block'));
            this.track.appendChild(clone);
          }
        }

        setPaused(paused) {
          this.target = paused ? 0 : this.speed;
          this.start();
        }

        start() {
          if (this.running || !this.visible) return;
          this.running = true;
          this.last = performance.now();
          requestAnimationFrame((t) => this.tick(t));
        }

        // Muelle subamortiguado sobre la velocidad: frena con un pequeño retroceso y reanuda con suavidad
        tick(now) {
          if (!this.running) return;
          const dt = Math.min((now - this.last) / 1000, 0.05);
          this.last = now;

          const stiffness = 30;
          const damping = 3.5;
          this.accel += (stiffness * (this.target - this.velocity) - damping * this.accel) * dt;
          this.velocity += this.accel * dt;

          this.offset += this.velocity * dt;
          if (this.loop) this.offset = ((this.offset % this.loop) + this.loop) % this.loop;
          this.track.style.transform = 'translate3d(' + -this.offset + 'px,0,0)';

          const settled = Math.abs(this.velocity - this.target) < 0.05 && Math.abs(this.accel) < 0.05;
          if (settled && this.target === 0) {
            this.velocity = 0;
            this.accel = 0;
            this.running = false;
            return;
          }
          if (!this.visible) {
            this.running = false;
            return;
          }
          requestAnimationFrame((t) => this.tick(t));
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "Barra de marcas",
  "tag": "section",
  "class": "section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Marcas que encontrarás en nuestros lotes"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Aviso legal",
      "default": "Las marcas mencionadas pertenecen a sus respectivos propietarios. AshVintage no está afiliada a ellas.",
      "info": "Déjalo vacío para ocultarlo."
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Velocidad",
      "info": "Píxeles por segundo. Más bajo = más lento; con 30 se leen bien muchos logos.",
      "default": 30
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen superior",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen inferior",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marca",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Nombre",
          "default": "Marca"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo (opcional)",
          "info": "Si subes un logo, se usa en lugar del nombre. Recomendado: PNG o SVG transparente."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra de marcas",
      "blocks": [
        { "type": "brand", "settings": { "name": "Moncler" } },
        { "type": "brand", "settings": { "name": "Ralph Lauren" } },
        { "type": "brand", "settings": { "name": "The North Face" } },
        { "type": "brand", "settings": { "name": "Adidas" } },
        { "type": "brand", "settings": { "name": "Nike" } },
        { "type": "brand", "settings": { "name": "Napapijri" } },
        { "type": "brand", "settings": { "name": "Dior" } },
        { "type": "brand", "settings": { "name": "Prada" } },
        { "type": "brand", "settings": { "name": "Louis Vuitton" } }
      ]
    }
  ]
}
{% endschema %}
